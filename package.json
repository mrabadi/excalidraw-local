{
  "name": "excalidraw-local",
  "version": "0.1.0",
  "private": true,
  "description": "A local-only, network-isolated Excalidraw desktop app.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "prepare-assets": "node scripts/prepare-assets.mjs",
    "build:web": "npm run prepare-assets && vite build",
    "build": "npm run build:web && electron-builder --linux dir",
    "start": "electron ."
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.0",
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "local.excalidraw.offline",
    "productName": "Excalidraw Local",
    "files": ["dist/**", "electron/**", "package.json"],
    "linux": {
      "target": ["dir"],
      "category": "Graphics"
    }
  }
}
